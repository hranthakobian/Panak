    <!-- Main Window Surface: Pure borderless Material You card -->
    <Border x:Name="MainWindowBorder" Margin="0" CornerRadius="24" Background="{DynamicResource M3SurfaceBrush}" BorderThickness="0" BorderBrush="Transparent">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Settings Scrollable Body -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Header: Full-width draggable, dynamic vector SVG logo, no close button -->
            <Grid Grid.Row="0" Margin="0,0,0,16" Background="Transparent" MouseDown="Header_MouseDown" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Dynamic Vector Panak SVG Logo (svg/settings.svg) -->
                    <Viewbox Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Canvas Width="88" Height="88" Clip="M 0,0 L 88,0 L 88,88 L 0,88 Z">
                            <!-- 1. Scalloped container badge base -->
                            <Path Data="M59.4086 1.20571C76.2803 -3.9745 92.0771 11.8223 86.8968 28.694L84.1639 37.595C82.8719 41.8029 82.8719 46.3016 84.1639 50.5095L86.8968 59.4105C92.0771 76.2822 76.2803 92.079 59.4086 86.8988L50.5076 84.1659C46.2997 82.8739 41.8009 82.8739 37.593 84.1659L28.6921 86.8988C11.8203 92.079 -3.97645 76.2822 1.20376 59.4105L3.93668 50.5095C5.22865 46.3016 5.22865 41.8029 3.93668 37.595L1.20376 28.694C-3.97645 11.8223 11.8203 -3.9745 28.692 1.20571L37.593 3.93863C41.8009 5.23061 46.2997 5.23061 50.5076 3.93863L59.4086 1.20571Z"
                                  Fill="{DynamicResource LogoContainerBrush}"/>
                            <!-- 2. Dark brown flower/scallop bottom-left shape -->
                            <Path Data="M23.0319 48.198C24.8429 45.2673 29.1571 45.2673 30.9681 48.198C31.9209 49.7399 33.7031 50.5863 35.5195 50.3597C38.9718 49.9288 41.6617 53.2555 40.4677 56.4791C39.8394 58.1752 40.2795 60.0771 41.5918 61.3364C44.0858 63.7298 43.1258 67.878 39.8258 68.9672C38.0895 69.5402 36.8562 71.0654 36.6761 72.8624C36.3338 76.2778 32.4467 78.1239 29.5259 76.2585C27.989 75.2769 26.011 75.2769 24.4741 76.2585C21.5533 78.1239 17.6662 76.2778 17.3239 72.8624C17.1438 71.0654 15.9105 69.5402 14.1742 68.9672C10.8742 67.878 9.91423 63.7298 12.4082 61.3364C13.7205 60.0771 14.1606 58.1752 13.5323 56.4791C12.3383 53.2555 15.0282 49.9288 18.4805 50.3597C20.2969 50.5863 22.0791 49.7399 23.0319 48.198Z"
                                  Fill="{DynamicResource LogoCloudBrush}"/>
                            <!-- 3. Upper left triangle shape -->
                            <Path Data="M22.303 11.7907C24.3905 8.06977 29.6095 8.06976 31.697 11.7907L42.2653 30.6279C44.3528 34.3488 41.7434 39 37.5683 39H16.4317C12.2566 39 9.64716 34.3488 11.7347 30.6279L22.303 11.7907Z"
                                  Fill="{DynamicResource LogoTriangleBrush}"/>
                            <!-- 4. Lower right shield shape -->
                            <Path Data="M60.69 47.1992C62.9839 45.6003 66.0161 45.6003 68.31 47.1992L78.0961 54.0203C80.5738 55.7472 81.6123 58.9305 80.6373 61.8093L77.0467 72.4109C76.117 75.1559 73.5649 77 70.6955 77H58.3045C55.4351 77 52.883 75.1559 51.9533 72.4109L48.3627 61.8093C47.3877 58.9305 48.4262 55.7472 50.9039 54.0203L60.69 47.1992Z"
                                  Fill="{DynamicResource LogoShieldBrush}"/>
                            <!-- 5. Rotated ellipse shape -->
                            <Path Fill="{DynamicResource LogoEllipseBrush}">
                                <Path.Data>
                                    <EllipseGeometry Center="63.5067,24.3126" RadiusX="17.9667" RadiusY="10.1973">
                                        <EllipseGeometry.Transform>
                                            <RotateTransform Angle="-49.923" CenterX="63.5067" CenterY="24.3126"/>
                                        </EllipseGeometry.Transform>
                                    </EllipseGeometry>
                                </Path.Data>
                            </Path>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="TitleText" Text="Panak Settings" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Ko-fi Donation Support Card & Contact (Top of Settings) -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="☕" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SupportTitleText" Text="Աջակցել նախագծին (Ko-fi)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SupportDescText" Text="Աջակցեք Panak-ի զարգացմանը Ko-fi-ի միջոցով" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="KofiButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Content="☕ Ko-fi" VerticalAlignment="Center" Padding="18,8" FontWeight="Bold" Click="KofiButton_Click"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,2,0,8" BorderThickness="0"/>

                            <!-- Clickable contact links row -->
                            <WrapPanel Margin="0,2,0,0">
                                <!-- Email link -->
                                <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="14" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" MouseDown="EmailLink_MouseDown" ToolTip="dev@hakobian.am">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✉ " FontSize="11" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                        <TextBlock Text="dev@hakobian.am" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Website link -->
                                <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="14" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" MouseDown="WebsiteLink_MouseDown" ToolTip="https://hakobian.am/contact">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🌐 " FontSize="11" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                        <TextBlock Text="hakobian.am" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Language Selection with AI Notice -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="LanguageLabel" Text="Language" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LanguageAiBadge" Text="Թարգմանված է ԱԲ-ով" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="140" Style="{StaticResource MaterialComboBoxStyle}" SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="Հայերեն" Tag="hy"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="Русский" Tag="ru"/>
                                <ComboBoxItem Content="Français" Tag="fr"/>
                                <ComboBoxItem Content="Español" Tag="es"/>
                                <ComboBoxItem Content="中文" Tag="zh"/>
                                <ComboBoxItem Content="العربية" Tag="ar"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Icon Shape -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="IconShapeLabel" Text="Default Icon Shape" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                <TextBlock Text="Adaptive Icon Shape" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="20" Padding="6,4" VerticalAlignment="Center" BorderThickness="0" SnapsToDevicePixels="True">
                                <StackPanel x:Name="SettingsShapeSelectorPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="SettingsShapeCircle" GroupName="SettingsShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                 Tag="{StaticResource GeomCircle}" ToolTip="Circle" Click="SettingsShape_Click"/>
                                    <RadioButton x:Name="SettingsShapeSquircle" GroupName="SettingsShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                 Tag="{StaticResource GeomSquircle}" ToolTip="Squircle" Click="SettingsShape_Click"/>
                                    <RadioButton x:Name="SettingsShapeClover" GroupName="SettingsShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                 Tag="{StaticResource GeomClover}" ToolTip="Clover" Click="SettingsShape_Click"/>
                                    <RadioButton x:Name="SettingsShapeScallop" GroupName="SettingsShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                 Tag="{StaticResource GeomScallop}" ToolTip="Scallop" Click="SettingsShape_Click"/>
                                    <RadioButton x:Name="SettingsShapeArch" GroupName="SettingsShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                 Tag="{StaticResource GeomArch}" ToolTip="Arch" Click="SettingsShape_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Theme Mode: Light | Dark | Auto -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="ThemeSectionLabel" Text="Theme" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                            <TextBlock x:Name="ThemeSectionDesc" Text="Light, Dark or System Theme" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,10"/>
                            <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="14" Padding="3" HorizontalAlignment="Stretch">
                                <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                                    <RadioButton x:Name="SettingsThemeLight" GroupName="SettingsThemeGroup" Style="{StaticResource SettingsThemeSegmentRadioStyle}" Content="☀️ Light" Tag="Light" Click="SettingsTheme_Click"/>
                                    <RadioButton x:Name="SettingsThemeDark" GroupName="SettingsThemeGroup" Style="{StaticResource SettingsThemeSegmentRadioStyle}" Content="🌙 Dark" Tag="Dark" Click="SettingsTheme_Click"/>
                                    <RadioButton x:Name="SettingsThemeAuto" GroupName="SettingsThemeGroup" Style="{StaticResource SettingsThemeSegmentRadioStyle}" Content="⚙️ Auto" Tag="Auto" Click="SettingsTheme_Click"/>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Default Folder Color & Real-time Hue Slider -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DefaultColorLabel" Text="Default Folder Color" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock Text="Material You Real-time Dynamic Palette" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border x:Name="SettingsColorIndicator" Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource M3SurfaceContainerBrush}" BorderThickness="0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Preset Pastel Swatches: Now with 8 colors -->
                            <StackPanel x:Name="SettingsColorSwatchesPanel" Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="SettingsAccentSwatch" GroupName="SettingsColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#FCDDC5" Tag="#FCDDC5" ToolTip="Peach / Default" Checked="SettingsColorSwatch_Checked"/>
                                <RadioButton GroupName="SettingsColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#C5FCC5" Tag="#C5FCC5" ToolTip="Mint" Checked="SettingsColorSwatch_Checked"/>
                                <RadioButton GroupName="SettingsColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#C5FCFC" Tag="#C5FCFC" ToolTip="Cyan" Checked="SettingsColorSwatch_Checked"/>
                                <RadioButton GroupName="SettingsColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#C5DDFC" Tag="#C5DDFC" ToolTip="Sky Blue" Checked="SettingsColorSwatch_Checked"/>
                                <RadioButton GroupName="SettingsColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#DDC5FC" Tag="#DDC5FC" ToolTip="Lavender" Checked="SettingsColorSwatch_Checked"/>
                                <RadioButton GroupName="SettingsColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#FCC5FC" Tag="#FCC5FC" ToolTip="Lilac" Checked="SettingsColorSwatch_Checked"/>
                                <RadioButton GroupName="SettingsColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#FCC5DD" Tag="#FCC5DD" ToolTip="Rose" Checked="SettingsColorSwatch_Checked"/>
                                <RadioButton GroupName="SettingsColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#FCFCC5" Tag="#FCFCC5" ToolTip="Butter Yellow" Checked="SettingsColorSwatch_Checked"/>
                            </StackPanel>

                            <!-- Pastel Hue Slider: Panel updates in real time (Stretched full width) -->
                            <Slider x:Name="SettingsHueSlider"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,4,0,0"
                                    Minimum="0" Maximum="360"
                                    SmallChange="1" LargeChange="10"
                                    Style="{StaticResource PastelHueSliderStyle}"
                                    ValueChanged="SettingsHueSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- General Folder Opacity Slider -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="GeneralFolderOpacityLabel" Text="General Folder Opacity" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="GeneralFolderOpacityDescText" Text="Overall background opacity for all folders" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="GeneralFolderOpacityValueText" Grid.Column="1" Text="85%" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                            </Grid>
                            <Slider x:Name="GeneralFolderOpacitySlider" Minimum="20" Maximum="100" Value="85" SmallChange="1" LargeChange="5" Style="{StaticResource MaterialSliderStyle}" ValueChanged="GeneralFolderOpacitySlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Folder Blur & Radius -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="FolderBlurLabel" Text="Folder Blur Effect" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="FolderBlurDescText" Text="Blur desktop background behind folder cards" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="FolderBlurCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                            </Grid>
                            <StackPanel x:Name="FolderBlurSliderContainer" ClipToBounds="True">
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FolderBlurRadiusLabel" Text="Blur Radius" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                    <TextBlock x:Name="FolderBlurValueText" Grid.Column="1" Text="28 px" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="FolderBlurSlider" Minimum="2" Maximum="60" Value="28" Style="{StaticResource MaterialSliderStyle}" ValueChanged="FolderBlurSlider_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Grid Layout & Paging Mode -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <!-- Paging Mode -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PagingModeLabel" Text="Page Navigation Mode" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="PagingModeDescText" Text="Use paged slider or vertical scrollbar" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="PagingSliderRadio" Content="Slider" GroupName="PagingModeGroup" IsChecked="True" Margin="0,0,10,0" Checked="PagingModeRadio_Checked"/>
                                    <RadioButton x:Name="PagingScrollbarRadio" Content="ScrollBar" GroupName="PagingModeGroup" Checked="PagingModeRadio_Checked"/>
                                </StackPanel>
                            </Grid>

                            <!-- Columns Slider -->
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="GridColumnsLabel" Text="Items per row" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                <TextBlock x:Name="GridColumnsValueText" Grid.Column="1" Text="5" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                            </Grid>
                            <Slider x:Name="GridColumnsSlider" Minimum="3" Maximum="8" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource MaterialSliderStyle}" ValueChanged="GridColumnsSlider_ValueChanged"/>

                            <!-- Rows Slider (for Slider mode) -->
                            <StackPanel x:Name="GridRowsContainer" Margin="0,8,0,0">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GridRowsLabel" Text="Rows per page" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="GridRowsValueText" Grid.Column="1" Text="3" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="GridRowsSlider" Minimum="1" Maximum="5" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource MaterialSliderStyle}" ValueChanged="GridRowsSlider_ValueChanged"/>
                            </StackPanel>

                            <!-- Slider Navigation Options -->
                            <StackPanel x:Name="SliderInteractionsContainer" Margin="0,10,0,0">
                                <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,0,0,10" BorderThickness="0"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SliderArrowsLabel" Text="Show arrow navigation buttons" FontSize="13" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="SliderArrowsCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SliderDragLabel" Text="Mouse drag swipe on pages" FontSize="13" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="SliderDragCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Focus Mode & Dimming -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="FocusModeLabel" Text="Focus Mode" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="FocusModeDescText" Text="Dims background on popup open" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="FocusModeCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                            </Grid>
                            <Grid Margin="0,8,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FocusDimmingLabel" Text="Focus Dimming Opacity" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                <TextBlock x:Name="FocusDimmingValueText" Grid.Column="1" Text="45%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                            </Grid>
                            <Slider x:Name="FocusDimmingSlider" Minimum="0" Maximum="80" Value="45" Style="{StaticResource MaterialSliderStyle}" ValueChanged="FocusDimmingSlider_ValueChanged"/>

                            <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,10,0,10" BorderThickness="0"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="FocusBlurLabel" Text="Background Blur Effect" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="FocusBlurDescText" Text="Blur desktop background behind popup" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="FocusBlurCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                            </Grid>
                            <StackPanel x:Name="FocusBlurSliderContainer" ClipToBounds="True">
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FocusBlurRadiusLabel" Text="Blur Radius" FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                    <TextBlock x:Name="FocusBlurValueText" Grid.Column="1" Text="28 px" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="FocusBlurSlider" Minimum="2" Maximum="60" Value="28" Style="{StaticResource MaterialSliderStyle}" ValueChanged="FocusBlurSlider_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Center Screen Popup Only (New Option) -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CenterPopupLabel" Text="Center Screen Popup" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                <TextBlock x:Name="CenterPopupDescText" Text="Open folder popups in the center of the screen only" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="CenterPopupCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Lock Folders -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LockFoldersLabel" Text="Lock Folders" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                <TextBlock x:Name="LockFoldersDescText" Text="Disable dragging or moving items" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="LockFoldersCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Right Double-Click & Space Quick Look -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="RightDoubleClickLabel" Text="Right Double-Click Open" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="RightDoubleClickDescText" Text="Open any Windows folder with right double-click" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="RightDoubleClickCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,4,0,10" BorderThickness="0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SpaceQuickLookLabel" Text="Quick Look (Space key)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="SpaceQuickLookDescText" Text="Press Space in Explorer to quickly view folder" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="SpaceQuickLookCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Key Shortcuts & Rebinding (Ստեղների վերագրանցում) -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock x:Name="KeyRebindingLabel" Text="Ստեղների վերագրանցում" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="KeyRebindingDescText" Text="Կարգավորեք ստեղնաշարի հիմնական դյուրանցումները" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="ResetKeysBtn" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Վերականգնել" Padding="12,5" FontSize="11" VerticalAlignment="Center" Click="ResetKeysBtn_Click"/>
                            </Grid>

                            <!-- Quick Look Hotkey Row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="QuickLookKeyRowLabel" Text="Արագ դիտում (Quick Look)" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="QuickLookKeyRowDesc" Text="Explorer-ում ընտրված պանակի արագ բացում" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="QuickLookKeysContainer" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,2,0,10" BorderThickness="0"/>

                            <!-- Close Popup Hotkey Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ClosePopupKeyRowLabel" Text="Փակել փոփափը (Close Popup)" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="ClosePopupKeyRowDesc" Text="Բացված պանակի փոփափը փակելու ստեղն" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="ClosePopupKeysContainer" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Combine Files On Drop (Android / iOS style) -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CombineFilesLabel" Text="Combine Files on Drop" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                <TextBlock x:Name="CombineFilesDescText" Text="Drop a file onto another file to combine into a Panak folder" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="CombineFilesCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                        </Grid>
                    </Border>

                    <!-- Auto-start & Shell Context Menu Integration -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AutoStartLabel" Text="Start with Windows" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource M3SurfaceContainerBrush}" Margin="0,4,0,8" BorderThickness="0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ContextMenuStatusText" Text="Explorer context menu active" FontSize="12" Foreground="{DynamicResource M3PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="ReRegisterContextBtn" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Re-register" Padding="12,5" FontSize="11" Click="ReRegisterContextBtn_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GitHub Real-time Updates -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdatesSectionTitle" Text="Updates" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="UpdatesSectionDesc" Text="Real-time updates via GitHub Releases" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="CheckUpdatesBtn" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Check for updates" Padding="14,6" FontSize="12" Click="CheckUpdatesBtn_Click"/>
                            </Grid>

                            <!-- Version & Status Row -->
                            <Border Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="UpdateStatusTitleText" Text="Current version: v1.9.0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                        <TextBlock x:Name="UpdateStatusDetailText" Text="You are using the latest version" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="UpdateStatusBadge" Grid.Column="1" Text="✓ Latest" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Update Available Card (Visible when update found) -->
                            <Border x:Name="UpdateAvailableCard" Background="{DynamicResource M3CardBrush}" BorderBrush="{DynamicResource M3PrimaryBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="NewVersionAvailableText" Text="New version available: v1.1.0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                        <TextBlock x:Name="NewVersionDateText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                    </Grid>
                                    <TextBlock x:Name="ReleaseNotesHeader" Text="Release Notes:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                        <TextBlock x:Name="ReleaseNotesContentText" Text="" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    </ScrollViewer>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <controls:WavyProgressBar x:Name="UpdateProgressBar" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                                        <Button x:Name="DownloadInstallBtn" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Content="Download &amp; Install" Padding="16,6" FontSize="12" Click="DownloadInstallBtn_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Auto Check Toggle -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AutoCheckUpdatesLabel" Text="Check for updates automatically" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="AutoCheckUpdatesDesc" Text="Periodically check GitHub in the background" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoCheckUpdatesCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" VerticalAlignment="Center" IsChecked="True"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Installer & Uninstaller Tools -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="InstallerSectionTitle" Text="Ապատեղադրիչ" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UninstallAppBtn" Style="{StaticResource DangerButtonStyle}" Content="Uninstall" Padding="14,6" Click="UninstallAppBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Panak v1.9.0" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelBtn" x:FieldModifier="public" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Margin="0,0,10,0" Click="CancelBtn_Click"/>
                    <Button x:Name="ApplyBtn" x:FieldModifier="public" Style="{StaticResource SecondaryButtonStyle}" Content="Apply" Margin="0,0,10,0" Click="ApplyBtn_Click"/>
                    <Button x:Name="SaveBtn" x:FieldModifier="public" Style="{StaticResource ActionButtonStyle}" Content="Save" Click="SaveBtn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
