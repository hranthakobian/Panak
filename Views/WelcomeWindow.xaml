                        <!-- Titles -->
                        <TextBlock x:Name="Step3TitleText" Text="Welcome to Panak" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                        <TextBlock x:Name="Step3SubtitleText" Text="Material 3 Expressive popup folders for Windows" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,12"/>

                        <!-- Highlights Card -->
                        <Border Style="{StaticResource MiniSectionCardStyle}" Padding="12,10">
                            <StackPanel>
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎨" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Feature1Text" Grid.Column="1" Text="Material You dynamic palettes &amp; expressive shapes" FontSize="11" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📂" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Feature2Text" Grid.Column="1" Text="Instant popup widgets with paged slider navigation" FontSize="11" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Feature3Text" Grid.Column="1" Text="Quick Look via Spacebar &amp; Right Double-Click integration" FontSize="11" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons: Ko-fi and Settings -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="KofiBtn" Grid.Column="0" Margin="0,0,4,0" Style="{StaticResource SecondaryActionButtonStyle}" Content="☕ Ko-fi" Click="KofiBtn_Click"/>
                            <Button x:Name="SettingsBtn" Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource SecondaryActionButtonStyle}" Content="⚙️ Settings" Click="SettingsBtn_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Actions Footer: Perfectly Centered Step Indicator Dots with Side Buttons -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <!-- Center: Pager Dots (Always strictly mathematically centered) -->
                <StackPanel x:Name="StepDotsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="StepDot0" Width="26" Height="8" CornerRadius="4" Background="{DynamicResource M3PrimaryBrush}" Margin="3,0" Cursor="Hand" MouseDown="StepDot_MouseDown" Tag="0"/>
                    <Border x:Name="StepDot1" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource M3TrackInactiveBrush}" Margin="3,0" Cursor="Hand" MouseDown="StepDot_MouseDown" Tag="1"/>
                    <Border x:Name="StepDot2" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource M3TrackInactiveBrush}" Margin="3,0" Cursor="Hand" MouseDown="StepDot_MouseDown" Tag="2"/>
                </StackPanel>

                <!-- Left: Back Button -->
                <Button x:Name="BackBtn" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource SecondaryActionButtonStyle}" Content="Back" Visibility="Collapsed" Click="BackBtn_Click"/>

                <!-- Right: Skip and Next Buttons -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="SkipBtn" Style="{StaticResource SecondaryActionButtonStyle}" Content="Skip" Margin="0,0,8,0" Click="SkipBtn_Click"/>
                    <Button x:Name="NextBtn" Style="{StaticResource ActionButtonStyle}" Content="Next" MinWidth="90" Click="NextBtn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
