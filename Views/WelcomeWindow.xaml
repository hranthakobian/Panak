<Window x:Class="Panak.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panak - Setup &amp; Welcome"
        Height="580"
        Width="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Material You (M3) Dynamic Color Brushes -->
        <SolidColorBrush x:Key="M3SurfaceBrush" Color="#FEF4EB"/>
        <SolidColorBrush x:Key="M3SurfaceContainerBrush" Color="#FCDDC5"/>
        <SolidColorBrush x:Key="M3CardBrush" Color="#FFF7F0"/>
        <SolidColorBrush x:Key="M3PrimaryBrush" Color="#7A5427"/>
        <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="#FEF4EB"/>
        <SolidColorBrush x:Key="M3OnSurfaceBrush" Color="#2B1D11"/>
        <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="#6E5643"/>
        <SolidColorBrush x:Key="M3TrackInactiveBrush" Color="#EED7C5"/>
        <SolidColorBrush x:Key="M3OutlineBrush" Color="#B59E8C"/>
        <SolidColorBrush x:Key="SettingsHueThumbBrush" Color="#7A5427"/>

        <!-- Dynamic Logo Brushes -->
        <SolidColorBrush x:Key="LogoContainerBrush" Color="#E5CBB4"/>
        <SolidColorBrush x:Key="LogoTriangleBrush" Color="#481A0A"/>
        <SolidColorBrush x:Key="LogoCloudBrush" Color="#884433"/>
        <SolidColorBrush x:Key="LogoShieldBrush" Color="#CFA636"/>
        <SolidColorBrush x:Key="LogoEllipseBrush" Color="#CF5D36"/>
        <SolidColorBrush x:Key="LogoTextBrush" Color="#481A0A"/>

        <!-- 5 Shape Geometries -->
        <StreamGeometry x:Key="GeomCircle">M 12,1 A 11,11 0 1 1 11.99,1 Z</StreamGeometry>
        <StreamGeometry x:Key="GeomSquircle">M 7,1 L 17,1 A 6,6 0 0 1 23,7 L 23,17 A 6,6 0 0 1 17,23 L 7,23 A 6,6 0 0 1 1,17 L 1,7 A 6,6 0 0 1 7,1 Z</StreamGeometry>
        <StreamGeometry x:Key="GeomClover">M 1,7 A 6,6 0 0 1 7,1 C 9.5,2.4 14.5,2.4 17,1 A 6,6 0 0 1 23,7 C 21.6,9.5 21.6,14.5 23,17 A 6,6 0 0 1 17,23 C 14.5,21.6 9.5,21.6 7,23 A 6,6 0 0 1 1,17 C 2.4,14.5 2.4,9.5 1,7 Z</StreamGeometry>
        <StreamGeometry x:Key="GeomScallop">M 12.00,0.80 Q 14.54,2.53 17.60,2.30 Q 18.93,5.07 21.70,6.40 Q 21.47,9.46 23.20,12.00 Q 21.47,14.54 21.70,17.60 Q 18.93,18.93 17.60,21.70 Q 14.54,21.47 12.00,23.20 Q 9.46,21.47 6.40,21.70 Q 5.07,18.93 2.30,17.60 Q 2.53,14.54 0.80,12.00 Q 2.53,9.46 2.30,6.40 Q 5.07,5.07 6.40,2.30 Q 9.46,2.53 12.00,0.80 Z</StreamGeometry>
        <StreamGeometry x:Key="GeomArch">M 1,12 A 11,11 0 0 1 23,12 L 23,19 A 4,4 0 0 1 19,23 L 5,23 A 4,4 0 0 1 1,19 Z</StreamGeometry>

        <!-- Android 5-Shape Selector Radio Style -->
        <Style x:Key="ShapeSelectorRadioStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="RootGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="UnselectedBg" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource M3SurfaceContainerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="SelectedPill" Width="0" Height="36" CornerRadius="18" Background="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                            <Path x:Name="ShapeGlyph" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="{DynamicResource M3OnSurfaceBrush}" Stretch="Uniform" Width="18" Height="18"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectedPill" Property="Width" Value="36"/>
                                <Setter TargetName="SelectedPill" Property="Opacity" Value="1"/>
                                <Setter TargetName="UnselectedBg" Property="Opacity" Value="0"/>
                                <Setter TargetName="ShapeGlyph" Property="Fill" Value="{DynamicResource M3OnPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Swatch Radio Style -->
        <Style x:Key="ColorSwatchStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="SwatchRoot">
                            <Ellipse x:Name="OuterRing" Stroke="{DynamicResource M3PrimaryBrush}" StrokeThickness="2.5" Visibility="Collapsed" Margin="-3"/>
                            <Ellipse Fill="{TemplateBinding Background}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchRoot" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pastel Spectrum Hue Slider -->
        <Style x:Key="PastelHueThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="20" Height="20">
                            <Ellipse Stroke="#FFFFFF" StrokeThickness="3" Fill="{DynamicResource SettingsHueThumbBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PastelHueSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <Border Height="12" CornerRadius="6" BorderThickness="1" BorderBrush="#35000000" HorizontalAlignment="Stretch">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FCC5C5" Offset="0.0"/>
                                        <GradientStop Color="#FCDDC5" Offset="0.073"/>
                                        <GradientStop Color="#FCFCC5" Offset="0.166"/>
                                        <GradientStop Color="#DFFCC5" Offset="0.25"/>
                                        <GradientStop Color="#C5FCC5" Offset="0.333"/>
                                        <GradientStop Color="#C5FCDD" Offset="0.416"/>
                                        <GradientStop Color="#C5FCFC" Offset="0.5"/>
                                        <GradientStop Color="#C5DDFC" Offset="0.583"/>
                                        <GradientStop Color="#C5C5FC" Offset="0.666"/>
                                        <GradientStop Color="#DDC5FC" Offset="0.75"/>
                                        <GradientStop Color="#FCC5FC" Offset="0.833"/>
                                        <GradientStop Color="#FCC5DD" Offset="0.916"/>
                                        <GradientStop Color="#FCC5C5" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PastelHueThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Material 3 Standard Slider -->
        <Style x:Key="MaterialSliderThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="16" Height="16">
                            <Ellipse Fill="{DynamicResource M3PrimaryBrush}"/>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource M3OnPrimaryBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" Height="22">
                            <Border Height="8" CornerRadius="4" Background="{DynamicResource M3SurfaceContainerBrush}" BorderThickness="0" Margin="4,0,4,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8" CornerRadius="4" Background="{DynamicResource M3PrimaryBrush}" BorderThickness="0" Margin="4,0,-8,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MaterialSliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Material 3 Expressive Toggle Switch Style -->
        <Style x:Key="MaterialSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <!-- Track: 48x28 Pill -->
                            <Border x:Name="SwitchTrack" Width="48" Height="28" CornerRadius="14"
                                    BorderThickness="2" BorderBrush="{DynamicResource M3OutlineBrush}" Background="{DynamicResource M3TrackInactiveBrush}">
                                <Grid>
                                    <!-- Thumb: morphs between 14px circle (off) and 20px circle (on) -->
                                    <Border x:Name="SwitchThumb" Width="14" Height="14" CornerRadius="7"
                                            Background="{DynamicResource M3OnSurfaceVariantBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource M3PrimaryBrush}"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}"/>
                                <Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource M3OnPrimaryBrush}"/>
                                <Setter TargetName="SwitchThumb" Property="Width" Value="20"/>
                                <Setter TargetName="SwitchThumb" Property="Height" Value="20"/>
                                <Setter TargetName="SwitchThumb" Property="CornerRadius" Value="10"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="21,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Material 3 Expressive Radio Button Style -->
        <Style x:Key="M3ExpressiveRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" VerticalAlignment="Center" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Outer Ring -->
                            <Border x:Name="OuterRing" Width="20" Height="20" CornerRadius="10" BorderThickness="2"
                                    BorderBrush="{DynamicResource M3OutlineBrush}" Background="Transparent"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Inner Bloom Dot -->
                                <Border x:Name="InnerDot" Width="0" Height="0" CornerRadius="5"
                                        Background="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Opacity="0"/>
                            </Border>
                            <!-- Content -->
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}"/>
                                <Setter TargetName="InnerDot" Property="Opacity" Value="1"/>
                                <Setter TargetName="InnerDot" Property="Width" Value="10"/>
                                <Setter TargetName="InnerDot" Property="Height" Value="10"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Icon Button Style -->
        <Style x:Key="CloseIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceVariantBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HoverCircle" Width="30" Height="30" CornerRadius="15" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverCircle" Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource M3OnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button Style -->
        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="secBorder" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="secBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Section Card Style -->
        <Style x:Key="MiniSectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource M3CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <!-- Main Window Surface -->
    <Border x:Name="MainWindowBorder" Margin="0" CornerRadius="24" Background="{DynamicResource M3SurfaceBrush}" BorderThickness="0" BorderBrush="Transparent">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content Area (Step 1, Step 2, Step 3) -->
                <RowDefinition Height="Auto"/> <!-- Actions Footer -->
            </Grid.RowDefinitions>

            <!-- Header: Draggable with Title & Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,10" Background="Transparent" MouseDown="Header_MouseDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Panak Logo + Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="88" Height="88">
                            <Path Data="M59.4086 1.20571C76.2803 -3.9745 92.0771 11.8223 86.8968 28.694L84.1639 37.595C82.8719 41.8029 82.8719 46.3016 84.1639 50.5095L86.8968 59.4105C92.0771 76.2822 76.2803 92.079 59.4086 86.8988L50.5076 84.1659C46.2997 82.8739 41.8009 82.8739 37.593 84.1659L28.6921 86.8988C11.8203 92.079 -3.97645 76.2822 1.20376 59.4105L3.93668 50.5095C5.22865 46.3016 5.22865 41.8029 3.93668 37.595L1.20376 28.694C-3.97645 11.8223 11.8203 -3.9745 28.692 1.20571L37.593 3.93863C41.8009 5.23061 46.2997 5.23061 50.5076 3.93863L59.4086 1.20571Z"
                                  Fill="{DynamicResource LogoContainerBrush}"/>
                            <Path Data="M23.0319 48.198C24.8429 45.2673 29.1571 45.2673 30.9681 48.198C31.9209 49.7399 33.7031 50.5863 35.5195 50.3597C38.9718 49.9288 41.6617 53.2555 40.4677 56.4791C39.8394 58.1752 40.2795 60.0771 41.5918 61.3364C44.0858 63.7298 43.1258 67.878 39.8258 68.9672C38.0895 69.5402 36.8562 71.0654 36.6761 72.8624C36.3338 76.2778 32.4467 78.1239 29.5259 76.2585C27.989 75.2769 26.011 75.2769 24.4741 76.2585C21.5533 78.1239 17.6662 76.2778 17.3239 72.8624C17.1438 71.0654 15.9105 69.5402 14.1742 68.9672C10.8742 67.878 9.91423 63.7298 12.4082 61.3364C13.7205 60.0771 14.1606 58.1752 13.5323 56.4791C12.3383 53.2555 15.0282 49.9288 18.4805 50.3597C20.2969 50.5863 22.0791 49.7399 23.0319 48.198Z"
                                  Fill="{DynamicResource LogoCloudBrush}"/>
                            <Path Data="M22.303 11.7907C24.3905 8.06977 29.6095 8.06976 31.697 11.7907L42.2653 30.6279C44.3528 34.3488 41.7434 39 37.5683 39H16.4317C12.2566 39 9.64716 34.3488 11.7347 30.6279L22.303 11.7907Z"
                                  Fill="{DynamicResource LogoTriangleBrush}"/>
                            <Path Data="M60.69 47.1992C62.9839 45.6003 66.0161 45.6003 68.31 47.1992L78.0961 54.0203C80.5738 55.7472 81.6123 58.9305 80.6373 61.8093L77.0467 72.4109C76.117 75.1559 73.5649 77 70.6955 77H58.3045C55.4351 77 52.883 75.1559 51.9533 72.4109L48.3627 61.8093C47.3877 58.9305 48.4262 55.7472 50.9039 54.0203L60.69 47.1992Z"
                                  Fill="{DynamicResource LogoShieldBrush}"/>
                            <Path Fill="{DynamicResource LogoEllipseBrush}">
                                <Path.Data>
                                    <EllipseGeometry Center="63.5067,24.3126" RadiusX="17.9667" RadiusY="10.1973">
                                        <EllipseGeometry.Transform>
                                            <RotateTransform Angle="-49.923" CenterX="63.5067" CenterY="24.3126"/>
                                        </EllipseGeometry.Transform>
                                    </EllipseGeometry>
                                </Path.Data>
                            </Path>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Panak" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Step Progress Badge -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource M3SurfaceContainerBrush}" CornerRadius="12" Padding="14,4">
                    <TextBlock x:Name="StepIndicatorText" Text="Քայլ 1 / 3" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                </Border>

                <!-- Right: Close Button -->
                <Button Grid.Column="2" Style="{StaticResource CloseIconButtonStyle}" Content="✕" Width="28" Height="28" Click="CloseBtn_Click"/>
            </Grid>

            <!-- Main Multi-Step Content Area -->
            <Grid Grid.Row="1" Margin="0,4,0,10" ClipToBounds="True">

                <!-- STEP 1: Color, Shape, Opacity, Blur -->
                <Grid x:Name="Step1Grid" Visibility="Visible">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="Step1Translate" X="0"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Step 1 Controls -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Step1TitleText" Text="Step 1: Color, Shape &amp; Blur" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                        <TextBlock x:Name="Step1SubtitleText" Text="Personalize the visual look and feel of your folders" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,8"/>

                        <!-- Shape Selector Card -->
                        <Border Style="{StaticResource MiniSectionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Step1ShapeLabel" Text="Icon Shape" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton x:Name="ShapeCircleRadio" GroupName="WizardShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                 Tag="{StaticResource GeomCircle}" ToolTip="Circle" Click="ShapeRadio_Click"/>
                                    <RadioButton x:Name="ShapeSquircleRadio" GroupName="WizardShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                 Tag="{StaticResource GeomSquircle}" ToolTip="Squircle" IsChecked="True" Click="ShapeRadio_Click"/>
                                    <RadioButton x:Name="ShapeCloverRadio" GroupName="WizardShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                 Tag="{StaticResource GeomClover}" ToolTip="Clover" Click="ShapeRadio_Click"/>
                                    <RadioButton x:Name="ShapeScallopRadio" GroupName="WizardShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                 Tag="{StaticResource GeomScallop}" ToolTip="Scallop" Click="ShapeRadio_Click"/>
                                    <RadioButton x:Name="ShapeArchRadio" GroupName="WizardShapeGroup" Style="{StaticResource ShapeSelectorRadioStyle}"
                                                 Tag="{StaticResource GeomArch}" ToolTip="Arch" Click="ShapeRadio_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Theme Color Card -->
                        <Border Style="{StaticResource MiniSectionCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Step1ColorLabel" Text="Theme Color &amp; Hue" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <Border x:Name="Step1ColorIndicator" Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource M3PrimaryBrush}"/>
                                </Grid>
                                <!-- Pastel Swatches -->
                                <StackPanel x:Name="Step1SwatchesPanel" Orientation="Horizontal" Margin="0,0,0,5">
                                    <RadioButton GroupName="WizardColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#FCDDC5" Tag="#FCDDC5" ToolTip="Peach" Checked="WizardColorSwatch_Checked"/>
                                    <RadioButton GroupName="WizardColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#C5FCC5" Tag="#C5FCC5" ToolTip="Mint" Checked="WizardColorSwatch_Checked"/>
                                    <RadioButton GroupName="WizardColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#C5FCFC" Tag="#C5FCFC" ToolTip="Cyan" Checked="WizardColorSwatch_Checked"/>
                                    <RadioButton GroupName="WizardColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#C5DDFC" Tag="#C5DDFC" ToolTip="Sky Blue" Checked="WizardColorSwatch_Checked"/>
                                    <RadioButton GroupName="WizardColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#DDC5FC" Tag="#DDC5FC" ToolTip="Lavender" Checked="WizardColorSwatch_Checked"/>
                                    <RadioButton GroupName="WizardColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#FCC5FC" Tag="#FCC5FC" ToolTip="Pink" Checked="WizardColorSwatch_Checked"/>
                                    <RadioButton GroupName="WizardColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#FCFCC5" Tag="#FCFCC5" ToolTip="Butter" Checked="WizardColorSwatch_Checked"/>
                                    <RadioButton GroupName="WizardColorGroup" Style="{StaticResource ColorSwatchStyle}" Background="#E6E0E9" Tag="#E6E0E9" ToolTip="Silver" Checked="WizardColorSwatch_Checked"/>
                                </StackPanel>
                                <!-- Hue Slider -->
                                <Slider x:Name="Step1HueSlider" Minimum="0" Maximum="360" Style="{StaticResource PastelHueSliderStyle}" ValueChanged="Step1HueSlider_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Folder Opacity Card -->
                        <Border Style="{StaticResource MiniSectionCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Step1OpacityLabel" Text="Folder Opacity" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <TextBlock x:Name="Step1OpacityValueText" Grid.Column="1" Text="85%" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="Step1OpacitySlider" Minimum="20" Maximum="100" Value="85" Style="{StaticResource MaterialSliderStyle}" ValueChanged="Step1OpacitySlider_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Folder Blur Card -->
                        <Border Style="{StaticResource MiniSectionCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Step1BlurLabel" Text="Folder Blur Effect" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="Step1BlurCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" IsChecked="True" Click="Step1BlurCheckBox_Click"/>
                                </Grid>
                                <StackPanel x:Name="Step1BlurRadiusContainer">
                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Step1RadiusLabel" Text="Blur Radius" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                        <TextBlock x:Name="Step1RadiusValueText" Grid.Column="1" Text="28 px" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                    </Grid>
                                    <Slider x:Name="Step1BlurRadiusSlider" Minimum="2" Maximum="60" Value="28" Style="{StaticResource MaterialSliderStyle}" ValueChanged="Step1BlurRadiusSlider_ValueChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Step 1 Live Desktop Preview -->
                    <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="18" Background="#181824" BorderThickness="0" ClipToBounds="True">
                        <Grid>
                            <!-- Real Windows / Wallpaper Engine Wallpaper Background -->
                            <Image x:Name="Step1WallpaperImage" Stretch="UniformToFill"/>

                            <!-- Live Preview Badge (Clean pill without star) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Background="#8A000000" CornerRadius="8" Padding="10,4">
                                <TextBlock x:Name="Step1LivePreviewBadge" Text="Live Preview" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>

                            <!-- Desktop Folder Icon on Wallpaper -->
                            <StackPanel x:Name="Step1DesktopIcon" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20" Cursor="Hand" MouseDown="DesktopIcon_MouseDown" ToolTip="Click to open or close Panak">
                                <Grid Width="48" Height="48" HorizontalAlignment="Center">
                                    <Border x:Name="Step1DesktopIconPlate" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource M3PrimaryBrush}">
                                        <Path x:Name="Step1DesktopIconShapePath" Data="{StaticResource GeomSquircle}" Stretch="Uniform" Width="24" Height="24" Fill="{DynamicResource M3OnPrimaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="📂" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="Step1DesktopIconLabel" Text="Panak" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" TextAlignment="Center" Margin="0,3,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="#000000"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>

                            <!-- Folder Popup Card (Realistic interactive popup) -->
                            <Grid x:Name="Step1PopupContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="Step1PopupScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>

                                <!-- True Background Blur Layer: Wallpaper with BlurEffect clipped to Folder Shape -->
                                <Border x:Name="Step1BlurUnderlay" Width="270" Height="260" CornerRadius="20" ClipToBounds="True">
                                    <Image x:Name="Step1BlurredWallpaperImage" Stretch="UniformToFill">
                                        <Image.Effect>
                                            <BlurEffect x:Name="Step1FolderBlurFx" Radius="28" RenderingBias="Performance"/>
                                        </Image.Effect>
                                    </Image>
                                </Border>

                                <!-- Folder Card Foreground Surface -->
                                <Border x:Name="Step1FolderCardBorder" Width="270" Height="260" CornerRadius="20" Background="#C6FCDDC5" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Header -->
                                            <RowDefinition Height="*"/>    <!-- Items Viewport -->
                                            <RowDefinition Height="Auto"/> <!-- Centered Pager Footer -->
                                        </Grid.RowDefinitions>

                                        <!-- Header: Shape badge + title + close button -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Step1PreviewShapeBadge" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource M3PrimaryBrush}">
                                                <Path x:Name="Step1PreviewShapePath" Data="{StaticResource GeomSquircle}" Stretch="Uniform" Width="12" Height="12" Fill="{DynamicResource M3OnPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock x:Name="Step1PreviewFolderTitle" Text="Panak" Grid.Column="1" Margin="6,0,0,0" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                            <Button x:Name="Step1PreviewCloseBtn" Grid.Column="2" Width="20" Height="20" Style="{StaticResource CloseIconButtonStyle}" Content="✕" FontSize="10" Click="PreviewCloseBtn_Click" ToolTip="Close"/>
                                        </Grid>

                                        <!-- Items Viewport: Slider Pages vs Scrollbar -->
                                        <Grid Grid.Row="1" ClipToBounds="True">
                                            <!-- Slider Viewport with MouseWheel & Drag -->
                                            <Grid x:Name="Step1SliderViewport" ClipToBounds="True" Visibility="Visible"
                                                  PreviewMouseDown="PreviewSlider_MouseDown"
                                                  PreviewMouseMove="PreviewSlider_MouseMove"
                                                  PreviewMouseUp="PreviewSlider_MouseUp"
                                                  PreviewMouseWheel="PreviewSlider_MouseWheel">
                                                <StackPanel x:Name="Step1SliderPagesPanel" Orientation="Horizontal">
                                                    <StackPanel.RenderTransform>
                                                        <TranslateTransform x:Name="Step1PagesTranslate" X="0"/>
                                                    </StackPanel.RenderTransform>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Scrollbar Mode Viewport -->
                                            <ScrollViewer x:Name="Step1ScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <UniformGrid x:Name="Step1ScrollGrid" Columns="4" HorizontalAlignment="Center"/>
                                            </ScrollViewer>
                                        </Grid>

                                        <!-- Footer: Centered Pager Controls (Slider mode) -->
                                        <Grid x:Name="Step1FooterPagerGrid" Grid.Row="2" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button x:Name="Step1PrevBtn" Width="22" Height="20" Style="{StaticResource SecondaryActionButtonStyle}" Padding="0" Content="‹" FontSize="14" FontWeight="Bold" Click="Step1PrevBtn_Click"/>
                                                <StackPanel x:Name="Step1DotsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"/>
                                                <Button x:Name="Step1NextBtn" Width="22" Height="20" Style="{StaticResource SecondaryActionButtonStyle}" Padding="0" Content="›" FontSize="14" FontWeight="Bold" Click="Step1NextBtn_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- STEP 2: Focus Mode & Paging Controls -->
                <Grid x:Name="Step2Grid" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="Step2Translate" X="0"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Step 2 Live Preview (Demonstrating Focus Mode & Slider Navigation) -->
                    <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="18" Background="#181824" BorderThickness="0" ClipToBounds="True">
                        <Grid>
                            <!-- Real Wallpaper -->
                            <Image x:Name="Step2WallpaperImage" Stretch="UniformToFill"/>

                            <!-- Focus Mode Dimming Backdrop -->
                            <Border x:Name="Step2FocusDimOverlay" Background="#000000" Opacity="0.45"/>

                            <!-- Live Focus & Slider Card -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                <!-- True Background Blur Underlay -->
                                <Border x:Name="Step2BlurUnderlay" Width="270" Height="260" CornerRadius="20" ClipToBounds="True">
                                    <Image x:Name="Step2BlurredWallpaperImage" Stretch="UniformToFill">
                                        <Image.Effect>
                                            <BlurEffect x:Name="Step2FolderBlurFx" Radius="28" RenderingBias="Performance"/>
                                        </Image.Effect>
                                    </Image>
                                </Border>

                                <Border x:Name="Step2FolderCardBorder" Width="270" Height="260" CornerRadius="20" Background="#C6FCDDC5" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Step2PreviewShapeBadge" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource M3PrimaryBrush}">
                                                <Path x:Name="Step2PreviewShapePath" Data="{StaticResource GeomSquircle}" Stretch="Uniform" Width="10" Height="10" Fill="{DynamicResource M3OnPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="Work Projects" Grid.Column="1" Margin="6,0,0,0" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Items Viewport -->
                                        <Grid Grid.Row="1" ClipToBounds="True">
                                            <Grid x:Name="Step2SliderViewport" ClipToBounds="True" Visibility="Visible"
                                                  PreviewMouseDown="PreviewSlider_MouseDown"
                                                  PreviewMouseMove="PreviewSlider_MouseMove"
                                                  PreviewMouseUp="PreviewSlider_MouseUp"
                                                  PreviewMouseWheel="PreviewSlider_MouseWheel">
                                                <StackPanel x:Name="Step2SliderPagesPanel" Orientation="Horizontal">
                                                    <StackPanel.RenderTransform>
                                                        <TranslateTransform x:Name="Step2PagesTranslate" X="0"/>
                                                    </StackPanel.RenderTransform>
                                                </StackPanel>
                                            </Grid>
                                            <ScrollViewer x:Name="Step2ScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <UniformGrid x:Name="Step2ScrollGrid" Columns="4" HorizontalAlignment="Center"/>
                                            </ScrollViewer>
                                        </Grid>

                                        <!-- Footer: Centered Pager Controls -->
                                        <Grid x:Name="Step2FooterPagerGrid" Grid.Row="2" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button x:Name="Step2PrevBtn" Width="22" Height="20" Style="{StaticResource SecondaryActionButtonStyle}" Padding="0" Content="‹" FontSize="14" FontWeight="Bold" Click="Step1PrevBtn_Click"/>
                                                <StackPanel x:Name="Step2DotsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"/>
                                                <Button x:Name="Step2NextBtn" Width="22" Height="20" Style="{StaticResource SecondaryActionButtonStyle}" Padding="0" Content="›" FontSize="14" FontWeight="Bold" Click="Step1NextBtn_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right: Step 2 Controls -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Step2TitleText" Text="Step 2: Layout &amp; Behavior" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                        <TextBlock x:Name="Step2SubtitleText" Text="Configure paging navigation, grid size, and Focus Mode" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,2,0,8"/>

                        <!-- Navigation Mode Card -->
                        <Border Style="{StaticResource MiniSectionCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Step2PagingModeLabel" Text="Page Navigation Mode" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton x:Name="Step2SliderRadio" Content="Slider" GroupName="WizardPagingGroup" Style="{StaticResource M3ExpressiveRadioButtonStyle}" IsChecked="True" Margin="0,0,10,0" Click="Step2Paging_Click"/>
                                        <RadioButton x:Name="Step2ScrollbarRadio" Content="ScrollBar" GroupName="WizardPagingGroup" Style="{StaticResource M3ExpressiveRadioButtonStyle}" Click="Step2Paging_Click"/>
                                    </StackPanel>
                                </Grid>
                                <!-- Columns & Rows -->
                                <Grid Margin="0,2,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Step2ColsLabel" Text="Columns per row" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                    <TextBlock x:Name="Step2ColsValueText" Grid.Column="1" Text="5" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="Step2ColsSlider" Minimum="3" Maximum="8" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource MaterialSliderStyle}" ValueChanged="Step2ColsSlider_ValueChanged"/>

                                <Grid Margin="0,3,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Step2RowsLabel" Text="Rows per page" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                    <TextBlock x:Name="Step2RowsValueText" Grid.Column="1" Text="3" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="Step2RowsSlider" Minimum="1" Maximum="5" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource MaterialSliderStyle}" ValueChanged="Step2RowsSlider_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Focus Mode Card -->
                        <Border Style="{StaticResource MiniSectionCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Step2FocusModeLabel" Text="Focus Mode" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="Step2FocusCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" IsChecked="True" Click="Step2FocusCheckBox_Click"/>
                                </Grid>
                                <Grid Margin="0,1,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Step2DimmingLabel" Text="Dimming opacity" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                    <TextBlock x:Name="Step2DimmingValueText" Grid.Column="1" Text="45%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}"/>
                                </Grid>
                                <Slider x:Name="Step2DimmingSlider" Minimum="10" Maximum="90" Value="45" Style="{StaticResource MaterialSliderStyle}" ValueChanged="Step2DimmingSlider_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Slider Extras Card -->
                        <Border Style="{StaticResource MiniSectionCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Step2ArrowsLabel" Text="Navigation Arrows" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="Step2ArrowsCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" IsChecked="True" Click="Step2ArrowsCheckBox_Click"/>
                                </Grid>
                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Step2DragLabel" Text="Mouse Drag / Swipe" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="Step2DragCheckBox" Grid.Column="1" Style="{StaticResource MaterialSwitchStyle}" IsChecked="True" Click="Step2DragCheckBox_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- STEP 3: Ready & Welcome (Dual Card Layout) -->
                <Grid x:Name="Step3Grid" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="Step3Translate" X="0"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Final Customized Folder Preview on Wallpaper -->
                    <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="18" Background="#181824" BorderThickness="0" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="Step3WallpaperImage" Stretch="UniformToFill"/>

                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                <Border x:Name="Step3BlurUnderlay" Width="270" Height="260" CornerRadius="20" ClipToBounds="True">
                                    <Image x:Name="Step3BlurredWallpaperImage" Stretch="UniformToFill">
                                        <Image.Effect>
                                            <BlurEffect x:Name="Step3FolderBlurFx" Radius="28" RenderingBias="Performance"/>
                                        </Image.Effect>
                                    </Image>
                                </Border>

                                <Border x:Name="Step3FolderCardBorder" Width="270" Height="260" CornerRadius="20" Background="#C6FCDDC5" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Step3PreviewShapeBadge" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource M3PrimaryBrush}">
                                                <Path x:Name="Step3PreviewShapePath" Data="{StaticResource GeomSquircle}" Stretch="Uniform" Width="11" Height="11" Fill="{DynamicResource M3OnPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="My Panak" Grid.Column="1" Margin="8,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Sample Grid -->
                                        <UniformGrid Grid.Row="1" Columns="3" Rows="2" VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center" Margin="2">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource M3SurfaceBrush}">
                                                    <TextBlock Text="🖼️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Photos" FontSize="9" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center" Margin="2">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource M3SurfaceBrush}">
                                                    <TextBlock Text="📄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Docs" FontSize="9" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center" Margin="2">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource M3SurfaceBrush}">
                                                    <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Projects" FontSize="9" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center" Margin="2">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource M3SurfaceBrush}">
                                                    <TextBlock Text="🎵" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Music" FontSize="9" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center" Margin="2">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource M3SurfaceBrush}">
                                                    <TextBlock Text="🎬" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Videos" FontSize="9" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center" Margin="2">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource M3SurfaceBrush}">
                                                    <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Archives" FontSize="9" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </UniformGrid>

                                        <!-- Footer dots -->
